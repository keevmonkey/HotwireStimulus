<header class="navbar" data-controller="navbar">
	<% if user_signed_in? %>
		<div class="navbar__brand">
			<%= current_company.name %>
		</div>
		<div class="navbar__menu">
			<%= link_to 'Home',
								root_path,
								data: { 'navbar-target': 'navbarMenuItem' },
								class: 'navbar__menu__item' %>
			<%= link_to 'Quotes',
								quotes_path,
								data: { 'navbar-target': 'navbarMenuItem' },
								class: 'navbar__menu__item' %>
		</div>
		<div class="navbar__name">
			<%= current_user.name %>
		</div>
		<%= button_to 'Sign out',
								destroy_user_session_path,
								method: :delete,
								class: 'btn btn--dark' %>
	<% else %>
		<%= link_to 'Sign in',
							new_user_session_path,
							class: 'btn btn--dark navbar__right' %>
	<% end %>
</header>
